---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const allBerita = await getCollection('berita');
const sorted = allBerita.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Berita & Kegiatan"
  description="Berita terkini, pengumuman, dan liputan kegiatan dari PPTQ Nurul Iman."
>
  <section class="pt-12 pb-10" aria-labelledby="berita-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-800/55">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-forest-700 transition-colors">Beranda</a></li>
          <li class="text-forest-700/50" aria-hidden="true">/</li>
          <li aria-current="page" class="font-semibold text-forest-800">Berita</li>
        </ol>
      </nav>

      <div class="mt-6 max-w-3xl">
        <p class="inline-flex items-center rounded-full border border-amber-300 bg-amber-50 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-amber-700">
          Berita &amp; Kegiatan
        </p>
        <h1 id="berita-heading" class="mt-4 font-display text-3xl font-bold leading-tight text-ink-900 sm:text-4xl">
          Kabar dan Kegiatan Pesantren
        </h1>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-800/65 sm:text-lg">
          Ikuti perkembangan, pengumuman, dan agenda terbaru dari lingkungan PPTQ Nurul Iman.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-20" aria-label="Daftar berita">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {sorted.length > 0 ? (
        <div class="flex flex-wrap justify-center gap-6">
          {sorted.map(post => (
            <NewsCard
              title={post.data.title}
              date={post.data.date}
              image={post.data.image}
              excerpt={post.data.excerpt}
              slug={post.slug}
              tags={post.data.tags}
              class="w-full max-w-[360px]"
            />
          ))}
        </div>
      ) : (
        <p class="py-12 text-center text-ink-800/55">Belum ada berita yang dipublikasikan.</p>
      )}
    </div>
  </section>
</BaseLayout>
                    </h2>
