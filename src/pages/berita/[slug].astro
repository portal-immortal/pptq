---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const beritaEntries = await getCollection('berita');
  return beritaEntries.map(entry => ({
    params: { slug: entry.slug },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formattedDate = new Date(entry.data.date).toLocaleDateString('id-ID', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const category = entry.data.tags?.[0] ?? 'Berita & Kegiatan';
---

<BaseLayout title={entry.data.title} description={entry.data.excerpt} ogImage={entry.data.image} ogType="article">
  <article class="py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-800/55">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-forest-700 transition-colors">Beranda</a></li>
          <li class="text-forest-700/50" aria-hidden="true">/</li>
          <li><a href="/berita" class="hover:text-forest-700 transition-colors">Berita</a></li>
          <li class="text-forest-700/50" aria-hidden="true">/</li>
          <li aria-current="page" class="max-w-full truncate font-semibold text-forest-800">{entry.data.title}</li>
        </ol>
      </nav>

      <header class="mx-auto mt-8 flex max-w-3xl flex-col items-center gap-4 text-center">
        <span class="inline-flex items-center rounded-full border border-amber-300 bg-amber-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-amber-700">
          {category}
        </span>
        <h1 class="font-display text-3xl font-bold leading-tight text-ink-900 sm:text-4xl lg:text-5xl">
          {entry.data.title}
        </h1>
        <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm font-medium text-ink-800/55">
          <time datetime={new Date(entry.data.date).toISOString().split('T')[0]}>{formattedDate}</time>
          <span aria-hidden="true">&middot;</span>
          <span>{entry.data.author}</span>
        </p>
      </header>

      <figure class="mx-auto my-10 w-full max-w-4xl overflow-hidden rounded-2xl border border-parchment-300 bg-white shadow-card">
        <img
          src={entry.data.image}
          alt={entry.data.title}
          class="h-auto w-full object-contain"
          loading="eager"
          decoding="async"
          onerror="this.src='https://placehold.co/1200x600/15803d/ffffff?text=PPTQ+News'"
        />
      </figure>

      <div class="prose-islamic mx-auto w-full max-w-3xl">
        <Content />
      </div>

      <div class="mx-auto mt-12 w-full max-w-3xl border-t border-parchment-300 pt-8">
        <a href="/berita" class="inline-flex min-h-[44px] items-center gap-2 rounded-full border-2 border-forest-700 px-6 py-3 font-semibold text-forest-700 transition-colors hover:bg-forest-50">
          <svg class="h-4 w-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
          Kembali ke Berita
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
